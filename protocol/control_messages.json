{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CordaControlMessages",
  "description": "Formal JSON Schema for Corda Control Channel (Port 54321) framing and message payloads.",
  "type": "object",
  "required": ["type", "timestamp"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "PAIR_REQUEST",
        "PAIR_RESPONSE",
        "CLIPBOARD_PAYLOAD",
        "HEARTBEAT_PING",
        "HEARTBEAT_PONG",
        "FILE_METADATA_HEADER",
        "FILE_TRANSFER_ABORT",
        "CLIPBOARD_FILE_ANNOUNCE",
        "OTP_DETECTED",
        "BATTERY_STATUS",
        "NOTIFICATION_MIRROR"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/PairRequest" },
    { "$ref": "#/definitions/PairResponse" },
    { "$ref": "#/definitions/ClipboardPayload" },
    { "$ref": "#/definitions/HeartbeatPing" },
    { "$ref": "#/definitions/HeartbeatPong" },
    { "$ref": "#/definitions/FileMetadataHeader" },
    { "$ref": "#/definitions/FileTransferAbort" },
    { "$ref": "#/definitions/ClipboardFileAnnounce" },
    { "$ref": "#/definitions/OtpDetected" },
    { "$ref": "#/definitions/BatteryStatus" },
    { "$ref": "#/definitions/NotificationMirror" }
  ],
  "definitions": {
    "PairRequest": {
      "type": "object",
      "required": ["type", "device_id", "device_name", "platform", "public_key", "fingerprint", "pin", "timestamp"],
      "properties": {
        "type": { "const": "PAIR_REQUEST" },
        "device_id": { "type": "string", "format": "uuid" },
        "device_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "type": "string", "enum": ["macos", "android"] },
        "public_key": { "type": "string", "description": "Base64 encoded DER/PEM public key" },
        "fingerprint": { 
          "type": "string", 
          "pattern": "^([0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2}$",
          "description": "SHA-256 fingerprint formatted with colon separators"
        },
        "pin": { "type": "string", "pattern": "^[0-9]{6}$" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "PairResponse": {
      "type": "object",
      "required": ["type", "device_id", "device_name", "platform", "public_key", "fingerprint", "status", "timestamp"],
      "properties": {
        "type": { "const": "PAIR_RESPONSE" },
        "device_id": { "type": "string", "format": "uuid" },
        "device_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platform": { "type": "string", "enum": ["macos", "android"] },
        "public_key": { "type": "string", "description": "Base64 encoded DER/PEM public key" },
        "fingerprint": { 
          "type": "string", 
          "pattern": "^([0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2}$" 
        },
        "status": { "type": "string", "enum": ["ACCEPTED", "REJECTED", "PIN_MISMATCH"] },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ClipboardPayload": {
      "type": "object",
      "required": ["type", "content", "content_type", "content_hash", "timestamp"],
      "properties": {
        "type": { "const": "CLIPBOARD_PAYLOAD" },
        "content": { "type": "string", "description": "UTF-8 text content" },
        "content_type": { "type": "string", "enum": ["text/plain", "text/uri-list"] },
        "content_hash": { 
          "type": "string", 
          "pattern": "^[0-9a-fA-F]{64}$",
          "description": "SHA-256 hex string used to prevent bidirectional echo loops"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2}$",
          "description": "Optional sender public key SHA-256 fingerprint for in-band authentication"
        },
        "device_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "HeartbeatPing": {
      "type": "object",
      "required": ["type", "seq", "timestamp"],
      "properties": {
        "type": { "const": "HEARTBEAT_PING" },
        "seq": { "type": "integer", "minimum": 0 },
        "fingerprint": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2}$",
          "description": "Optional sender public key SHA-256 fingerprint for in-band authentication"
        },
        "device_id": { "type": "string", "format": "uuid" },
        "device_name": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "HeartbeatPong": {
      "type": "object",
      "required": ["type", "seq", "timestamp"],
      "properties": {
        "type": { "const": "HEARTBEAT_PONG" },
        "seq": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "FileMetadataHeader": {
      "type": "object",
      "required": ["type", "transfer_id", "total_files", "total_bytes", "files", "timestamp"],
      "properties": {
        "type": { "const": "FILE_METADATA_HEADER" },
        "transfer_id": { "type": "string", "format": "uuid" },
        "total_files": { "type": "integer", "minimum": 1 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "relative_path", "size_bytes", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "relative_path": { "type": "string" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "FileTransferAbort": {
      "type": "object",
      "required": ["type", "transfer_id", "reason", "timestamp"],
      "properties": {
        "type": { "const": "FILE_TRANSFER_ABORT" },
        "transfer_id": { "type": "string", "format": "uuid" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ClipboardFileAnnounce": {
      "type": "object",
      "required": ["type", "transfer_id", "file_name", "mime_type", "size_bytes", "sha256", "timestamp"],
      "properties": {
        "type": { "const": "CLIPBOARD_FILE_ANNOUNCE" },
        "transfer_id": { "type": "string", "format": "uuid" },
        "file_name": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "fingerprint": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2}$"
        },
        "device_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "OtpDetected": {
      "type": "object",
      "required": ["type", "device_id", "service_name", "code", "expires_in", "timestamp"],
      "properties": {
        "type": { "const": "OTP_DETECTED" },
        "device_id": { "type": "string", "format": "uuid" },
        "service_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "code": { "type": "string", "pattern": "^[0-9]{4,8}$" },
        "expires_in": { "type": "integer", "minimum": 10, "maximum": 300 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "BatteryStatus": {
      "type": "object",
      "required": ["type", "device_id", "level", "is_charging", "power_source", "timestamp"],
      "properties": {
        "type": { "const": "BATTERY_STATUS" },
        "device_id": { "type": "string", "format": "uuid" },
        "level": { "type": "integer", "minimum": 0, "maximum": 100 },
        "is_charging": { "type": "boolean" },
        "power_source": { "type": "string", "enum": ["battery", "ac", "usb", "wireless"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "NotificationMirror": {
      "type": "object",
      "required": ["type", "device_id", "notification_id", "package_name", "app_name", "title", "text", "timestamp"],
      "properties": {
        "type": { "const": "NOTIFICATION_MIRROR" },
        "device_id": { "type": "string", "format": "uuid" },
        "notification_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "package_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "app_name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "text": { "type": "string", "maxLength": 2048 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "NotificationWhitelistSync": {
      "type": "object",
      "required": ["type", "device_id", "master_enabled", "apps", "timestamp"],
      "properties": {
        "type": { "const": "NOTIFICATION_WHITELIST_SYNC" },
        "device_id": { "type": "string", "format": "uuid" },
        "master_enabled": { "type": "boolean" },
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["package_name", "app_name", "is_enabled"],
            "properties": {
              "package_name": { "type": "string", "minLength": 1, "maxLength": 128 },
              "app_name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "is_enabled": { "type": "boolean" }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}


